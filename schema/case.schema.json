{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/chenghaoYang/dsh-regression/schema/case.schema.json",
  "title": "dsh-regression case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "fixture", "runner", "task", "checks"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "source": { "type": "object" },
    "fixture": {
      "type": "object",
      "required": ["repository", "git_ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "git_ref": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string" }
      }
    },
    "runner": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": { "enum": ["command", "dsh"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "profile": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "task": {
      "type": "object",
      "required": ["prompt"],
      "properties": { "prompt": { "type": "string", "minLength": 1 } }
    },
    "run": {
      "type": "object",
      "properties": {
        "trials": { "type": "integer", "minimum": 1 },
        "pass_policy": { "const": "all" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["command", "diff-path", "json-schema", "api-snapshot"] }
        }
      }
    }
  }
}
